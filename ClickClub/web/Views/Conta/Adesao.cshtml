@{
    Layout = null;
    var clubs = ViewBag.Clubes as JsonNode;
}
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Faça parte · ClickClub</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body>
<main class="login-shell"><section class="login-aside"><a class="brand" href="/conta/entrar"><span class="brand-mark">c</span><span>clickclub<small>Viva o seu clube</small></span></a><div class="hero"><span class="chip">SEU LUGAR É AQUI</span><h1>Um novo clube.<br />Novos encontros.<br /><em>Faça parte.</em></h1><p>Escolha sua unidade e envie sua solicitação. A administração do clube acompanha cada novo membro de perto.</p></div><footer>ClickClub · Sua comunidade, mais perto</footer></section>
<section class="login-card" style="max-width:580px"><p class="eyebrow">Comece sua história</p><h1>Solicitar adesão</h1><p>Após o envio, entre com sua conta para acompanhar a decisão. Serviços de associado serão liberados após a aprovação.</p>
@if (TempData["error"] is string error) { <div class="alert error" role="alert">@error</div> }
@if (ViewBag.Error is string connectionError) { <div class="alert error" role="alert">@connectionError <a href="/conta/adesao">Tentar novamente</a></div> }
<form method="post" action="/conta/adesao">@Html.AntiForgeryToken()<div class="form-grid"><div class="field full"><label for="clubeId">Unidade de origem *</label><select id="clubeId" name="clubeId" required>@if (clubs is JsonArray array) { foreach (var c in array) { <option value="@c?["id"]">@c?["nome"]</option> } }</select></div><div class="field full"><label for="nome">Nome completo *</label><input id="nome" name="nome" required autocomplete="name" /></div><div class="field full"><label for="email">E-mail *</label><input id="email" name="email" type="email" required autocomplete="email" /></div><div class="field full"><label for="tipoVinculo">Tipo de vínculo *</label><select id="tipoVinculo" name="tipoVinculo" required><option value="Convidado">Convidado</option><option value="Simpatizante">Simpatizante</option></select><small>O cadastro de Associado/Fundador é feito pela administração.</small></div><div class="field"><label for="login">Crie seu usuário *</label><input id="login" name="login" required autocomplete="username" /></div><div class="field"><label for="senha">Crie sua senha *</label><input id="senha" name="senha" type="password" required minlength="8" autocomplete="new-password" /><small>Mínimo de oito caracteres.</small></div></div><button class="button primary" type="submit">Enviar minha solicitação →</button></form><p class="login-footnote">Já tem uma conta? <a href="/conta/entrar">Entrar no ClickClub</a></p></section></main><script src="~/js/site.js" asp-append-version="true" defer></script></body></html>
